# === Anthropic (Claude) ===
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo que o bot vai usar para responder
CLAUDE_MODEL=claude-sonnet-4-5

# === Meta / WhatsApp Cloud API ===
# Token de acesso do app (temporário de 24h para testes, ou permanente de um System User)
# Gere em https://developers.facebook.com > seu app > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do número de telefone (Phone Number ID), encontrado na mesma tela acima
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Token que você mesmo inventa para validar o webhook na Meta (qualquer string forte)
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-secreta-aqui

# Versão da Graph API usada nas chamadas
GRAPH_API_VERSION=v21.0

# === Servidor ===
PORT=3000

# === Comportamento do bot (opcional) ===
# Por padrão o bot carrega o prompt de prompts/damaface-consultor-comercial.md
# (persona de Consultora Comercial da DamaFace, funil de vendas, objeções, etc).
# Para usar outro arquivo, aponte aqui:
# SYSTEM_PROMPT_FILE=prompts/outro-prompt.md
#
# Ou, se preferir não usar arquivo nenhum, defina o prompt direto na env var abaixo
# (o arquivo acima, se existir, tem prioridade sobre esta variável):
# SYSTEM_PROMPT="Você é um assistente prestativo respondendo pelo WhatsApp..."

# === Pausar atendimento para um humano (opcional) ===
# Quando o Claude decide que um humano precisa assumir a conversa (fechamento
# de agendamento ou pergunta que não pode responder com segurança), o bot
# marca aquele lead como pausado e para de responder automaticamente para ele.
#
# Número (formato internacional, só dígitos, ex: 5516999998888) para onde o
# bot avisa quando isso acontece. Opcional — sem ele, o bot só loga no console.
# ADMIN_PHONE_NUMBER=5516999998888
#
# Segredo simples para proteger os endpoints /admin/unpause e /admin/paused.
# Sem essa variável definida, os dois endpoints ficam desabilitados.
# ADMIN_SECRET=escolha-outra-string-secreta-aqui
