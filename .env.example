# === Anthropic (Claude) ===
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo que o bot vai usar para responder
CLAUDE_MODEL=claude-sonnet-4-5

# === Meta / WhatsApp Cloud API ===
# Token de acesso do app (temporário de 24h para testes, ou permanente de um System User)
# Gere em https://developers.facebook.com > seu app > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do número de telefone (Phone Number ID), encontrado na mesma tela acima
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Token que você mesmo inventa para validar o webhook na Meta (qualquer string forte)
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-secreta-aqui

# Versão da Graph API usada nas chamadas
GRAPH_API_VERSION=v21.0

# === Servidor ===
PORT=3000

# === Comportamento do bot (opcional) ===
# Instrução de sistema que define a personalidade/regras do bot
SYSTEM_PROMPT="Você é um assistente prestativo respondendo pelo WhatsApp. Seja claro, direto e use uma linguagem natural de conversa."
