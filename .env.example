# === Anthropic (Claude) ===
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo que o bot vai usar para responder
CLAUDE_MODEL=claude-sonnet-4-5

# === Meta / WhatsApp Cloud API ===
# Token de acesso do app (temporario de 24h para testes, ou permanente de um System User)
# Gere em https://developers.facebook.com > seu app > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do numero de telefone (Phone Number ID), encontrado na mesma tela acima
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Token que voce mesmo inventa para validar o webhook na Meta (qualquer string forte)
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-secreta-aqui

# Versao da Graph API usada nas chamadas
GRAPH_API_VERSION=v21.0

# === Servidor ===
PORT=3000

# === Comportamento do bot (opcional) ===
# Por padrao o bot carrega o prompt de prompts/damaface-consultor-comercial.md
# (persona de Consultora Comercial da DamaFace, funil de vendas, objecoes, etc).
# Para usar outro arquivo, aponte aqui:
# SYSTEM_PROMPT_FILE=prompts/outro-prompt.md
#
# Ou, se preferir nao usar arquivo nenhum, defina o prompt direto na env var abaixo
# (o arquivo acima, se existir, tem prioridade sobre esta variavel):
# SYSTEM_PROMPT="Voce e um assistente prestativo respondendo pelo WhatsApp..."
